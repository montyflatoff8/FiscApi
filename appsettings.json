{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DataSource": {
    "Provider": "SqlServer",
    "MigrateOnStartup": true
  },
  "Authentication": {
    "Enabled": true,
    "Issuer": "FiscApi",
    "Audience": "FiscApp",
    "AccessTokenMinutes": 60,
    "DemoUser": {
      "Username": "demo"
    }
  }
}
